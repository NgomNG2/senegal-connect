          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 403 Forbidden', () => pm.response.to.have.status(403));",
                  "const body = pm.response.json();",
                  "pm.test('Message évoque le rôle', () => pm.expect(body.erreur.toLowerCase()).to.include('rôle'));"
                ]
              }
            }
          ],
          "description": "Vérifie le message exact de garderRole() — c'est la seule requête de la collection qui le fait en détail. Les refus 403 suivants (1.12, 2.3) se contentent de vérifier le code HTTP, pour éviter de répéter la même assertion de contenu."
        },
        {
          "name": "1.9 GET /clients/:id — détail (200)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_agent}}"
