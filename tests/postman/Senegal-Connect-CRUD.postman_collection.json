      "key": "facture_id",
      "value": ""
    },
    {
      "key": "admin_password",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Setup — Comptes de test",
      "item": [
        {
          "name": "0.1 Login admin (compte seedé en base)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@senegalconnect.sn\",\n  \"mot_de_passe\": \"{{admin_password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Rôle = admin', () => pm.expect(body.utilisateur.role).to.eql('admin'));",
                  "pm.collectionVariables.set('token_admin', body.token);"
                ]
              }
            }
          ],
          "description": "Le register public ne permet jamais de créer un admin — on utilise le compte admin des données de test. admin_password doit être défini dans TON ENVIRONNEMENT LOCAL (jamais dans la collection) — voir senegal-connect.postman_environment.example.json."
        },
        {
          "name": "0.2 Register agent",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Ndao\",\n  \"prenom\": \"Agent\",\n  \"email\": \"agent.{{$timestamp}}@example.sn\",\n  \"mot_de_passe\": \"MotDePasse123\",\n  \"role\": \"agent\"\n}"
            }
          },
          "event": [
