            "url": "{{base_url}}/api/clients",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Autre\",\n  \"prenom\": \"Personne\",\n  \"email\": \"autre.{{$timestamp}}@example.sn\",\n  \"mot_de_passe\": \"MotDePasse123\",\n  \"msisdn\": \"{{msisdn_test}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 409', () => pm.response.to.have.status(409));"
