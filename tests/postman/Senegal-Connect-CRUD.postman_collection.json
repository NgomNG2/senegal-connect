            }
          ],
          "description": "Nécessite d'avoir exécuté 1.5 juste avant, pour que {{msisdn_test}} soit déjà pris."
        },
        {
          "name": "1.7 POST /clients — MSISDN mal formaté (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_agent}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/clients",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Mauvais\",\n  \"prenom\": \"Format\",\n  \"email\": \"mauvais.{{$timestamp}}@example.sn\",\n  \"mot_de_passe\": \"MotDePasse123\",\n  \"msisdn\": \"0771234567\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 422', () => pm.response.to.have.status(422));",
                  "const body = pm.response.json();",
                  "pm.test('Champ fautif = msisdn', () => {",
                  "    const champs = body.details.champs.map(c => c.champ);",
                  "    pm.expect(champs).to.include('msisdn');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.8 POST /clients — refusé pour un rôle client (403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_client}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/clients",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"X\",\n  \"prenom\": \"Y\",\n  \"email\": \"xy.{{$timestamp}}@example.sn\",\n  \"mot_de_passe\": \"MotDePasse123\",\n  \"msisdn\": \"+221709999999\"\n}"
            }
