          "description": "Vérifie uniquement que verifierJWT() est bien appliqué à cette route. Les 3 messages distincts (manquant/invalide/expiré) sont testés en détail dans la collection Auth — pas la peine de les redupliquer ici."
        },
        {
          "name": "1.5 POST /clients — création succès (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_agent}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/clients",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Kane\",\n  \"prenom\": \"Test\",\n  \"email\": \"kane.{{$timestamp}}@example.sn\",\n  \"mot_de_passe\": \"MotDePasse123\",\n  \"msisdn\": \"{{msisdn_genere}}\",\n  \"forfait_id\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Génère un MSISDN sénégalais VALIDE et unique à chaque exécution :",
                  "// +221 + préfixe mobile réel (70/75/76/77/78) + 7 chiffres aléatoires.",
                  "const prefixesValides = ['70', '75', '76', '77', '78'];",
                  "const prefixe = prefixesValides[Math.floor(Math.random() * prefixesValides.length)];",
                  "let suffixe = '';",
                  "for (let i = 0; i < 7; i++) {",
                  "    suffixe += Math.floor(Math.random() * 10);",
                  "}",
                  "pm.collectionVariables.set('msisdn_genere', '+221' + prefixe + suffixe);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Client contient id et msisdn', () => {",
                  "    pm.expect(body.client).to.have.property('id');",
                  "    pm.expect(body.client).to.have.property('msisdn');",
                  "});",
                  "pm.test('MSISDN renvoyé conforme au format sénégalais', () => {",
                  "    pm.expect(body.client.msisdn).to.match(/^\\+221[0-9]{9}$/);",
                  "});",
                  "// On stocke l'id EN NOMBRE (pas en texte) car c'est le type renvoyé",
                  "// par l'API (JSON number) — évite le bug de comparaison de types",
                  "// rencontré en 1.9 précédemment (String('6') !== 6 avec .eql()).",
                  "pm.collectionVariables.set('client_id', body.client.id);",
                  "pm.collectionVariables.set('msisdn_test', body.client.msisdn);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.6 POST /clients — MSISDN dupliqué (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_agent}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
