                  "const body = pm.response.json();",
                  "pm.test('Objet pagination complet', () => {",
                  "    pm.expect(body.pagination).to.have.all.keys('page','limite','total','totalPages');",
                  "});",
                  "pm.test('Nombre de résultats <= limite demandée', () => {",
                  "    pm.expect(body.donnees.length).to.be.at.most(3);",
