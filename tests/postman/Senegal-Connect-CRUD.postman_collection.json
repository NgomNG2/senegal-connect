            "url": {
              "raw": "{{base_url}}/api/clients?page=1&limite=3",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "clients"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limite",
                  "value": "3"
                }
              ]
            }
          },
